# LocalActivityMachine State Machine

# States
Executing: {
  shape: rectangle
}

MarkerCommandCreated: {
  shape: rectangle
}

MarkerCommandRecorded: {
  shape: rectangle
}

Replaying: {
  shape: rectangle
}

ReplayingPreResolved: {
  shape: rectangle
}

RequestSent: {
  shape: rectangle
}

ResultNotified: {
  shape: rectangle
}

WaitingMarkerEvent: {
  shape: rectangle
}

WaitingMarkerEventPreResolved: {
  shape: rectangle
}

# Transitions
Executing -> RequestSent: {
  label: "Schedule\n(on_schedule)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

Replaying -> WaitingMarkerEvent: {
  label: "Schedule\n(on_schedule)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

ReplayingPreResolved -> WaitingMarkerEventPreResolved: {
  label: "Schedule\n(on_schedule)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

RequestSent -> MarkerCommandCreated: {
  label: "HandleResult\n(on_handle_result)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

RequestSent -> RequestSent: {
  label: "Cancel\n(on_cancel_requested)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

RequestSent -> MarkerCommandCreated: {
  label: "NoWaitCancel\n(on_no_wait_cancel)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

MarkerCommandCreated -> ResultNotified: {
  label: "CommandRecordMarker\n(on_command_record_marker)"
  style.stroke: "#2e7d32"
  style.stroke-width: 2
}

ResultNotified -> MarkerCommandRecorded: {
  label: "MarkerRecorded\n(on_marker_recorded)"
  style.stroke: "#1565c0"
  style.stroke-width: 2
}

WaitingMarkerEvent -> MarkerCommandRecorded: {
  label: "MarkerRecorded\n(on_marker_recorded)"
  style.stroke: "#1565c0"
  style.stroke-width: 2
}

WaitingMarkerEvent -> WaitingMarkerEvent: {
  label: "Cancel\n(on_cancel_requested)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

WaitingMarkerEvent -> WaitingMarkerEvent: {
  label: "HandleKnownResult\n(on_handle_result)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

WaitingMarkerEvent -> WaitingMarkerEvent: {
  label: "NoWaitCancel\n(on_no_wait_cancel)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

WaitingMarkerEvent -> RequestSent: {
  label: "StartedNonReplayWFT\n(on_started_non_replay_wft)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

WaitingMarkerEventPreResolved -> MarkerCommandRecorded: {
  label: "MarkerRecorded\n(on_marker_recorded)"
  style.stroke: "#1565c0"
  style.stroke-width: 2
}

WaitingMarkerEventPreResolved -> WaitingMarkerEventPreResolved: {
  label: "Cancel"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

WaitingMarkerEventPreResolved -> WaitingMarkerEventPreResolved: {
  label: "NoWaitCancel"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

MarkerCommandRecorded -> MarkerCommandRecorded: {
  label: "Cancel\n(on_cancel_requested)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

MarkerCommandRecorded -> MarkerCommandRecorded: {
  label: "NoWaitCancel\n(on_no_wait_cancel)"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

MarkerCommandCreated -> MarkerCommandCreated: {
  label: "HandleResult"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

ResultNotified -> ResultNotified: {
  label: "HandleResult"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}

MarkerCommandRecorded -> MarkerCommandRecorded: {
  label: "HandleResult"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}


# Legend
legend_history_start: "" {style.opacity: 0}
legend_history_end: "" {style.opacity: 0}
legend_history_start -> legend_history_end: {
  label: "History Event"
  style.stroke: "#1565c0"
  style.stroke-width: 2
}

legend_command_start: "" {style.opacity: 0}
legend_command_end: "" {style.opacity: 0}
legend_command_start -> legend_command_end: {
  label: "Outgoing\nCommand"
  style.stroke: "#2e7d32"
  style.stroke-width: 2
}

legend_internal_start: "" {style.opacity: 0}
legend_internal_end: "" {style.opacity: 0}
legend_internal_start -> legend_internal_end: {
  label: "Activation Completion\nCommand /\nInternal Trigger"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
}
