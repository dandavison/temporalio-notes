shape: sequence_diagram

explanation: |md
  # Top-level Activity: within-namespace
  - New CHASM-backed product feature
| {
  near: top-center
  style.font-size: 14
}

C: {
  label: "Non-workflow\nSDK Client"
}

S: {
  label: "Cloud Cell"
}

TW: {
  label: "TopLevelActivity\nWorker"
}

C -> S: start_task(my_task) {
  style.font-color: "#D35400"
}

S.note: create CHASM instance\n\narchetype: TopLevelActivity

with_retries: "CHASM-backed retries" {
  S -> TW: TopLevelActivityTask
  TW -> S: result
}

S -> C: result {
  style.font-color: "green"
}
