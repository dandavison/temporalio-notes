shape: sequence_diagram

C: {
  label: Client
}
S: {
  label: Temporal\nServer
}
W: {
  label: Workflow\nWorker
}
S.style: {
  fill: "#B664FF"
  font-color: "#EEEEEE"
}

C.1 -> S: Update that\nexecutes an\nActivity
S -> C.1: Error:\nPer-workflow\nupdate limit\nexceeded {
  style.stroke-dash: 3
  style.stroke: red
  style.font-color: red
}
W -> S.1: poll
S.1 -> W.1: Update
W.1 -> S: Update Rejected\nby validator {
  style.stroke-dash: 3
  style.stroke: red
  style.font-color: red
}
S -> C.1: Error:\nUpdate failed\n(no history events) {
  style.stroke-dash: 3
  style.stroke: red
  style.font-color: red
}
W.1 -> S: Update Accepted
W.1."Update handler\n\nschedule activity\n...Activity Worker...\nreceive activity result"
W.1 -> S: Update Completed\nActivity failed\;\nno more retries: {
  style.stroke-dash: 3
  style.stroke: red
  style.font-color: red
}
S -> C.1: Error:\nUpdate failed {
  style.stroke-dash: 3
  style.stroke: red
  style.font-color: red
}
W.1 -> S.3: Update\nCompleted\nsuccessfully
S.3 -> C.1: Update Result
