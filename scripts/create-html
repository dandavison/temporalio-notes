#!/usr/bin/env uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "jinja2",
# ]
# ///

import sys
from pathlib import Path

from jinja2 import BaseLoader, Environment

glob, outfile, columns = sys.argv[1:]
outfile = Path(outfile).absolute()

# Find all SVG files using the provided glob pattern
svg_files = sorted(Path().glob(glob))
diagrams = [
    {
        "name": svg.stem,
        "path": str(svg.absolute().relative_to(outfile.parent, walk_up=True)),
        "alt": " ".join(word.capitalize() for word in svg.stem.split("-")),
    }
    for svg in svg_files
]

template = """<!DOCTYPE html>
<html>
<head>
    <title>Sequence Diagrams</title>
    <style>
        body {
            font-family: system-ui, -apple-system, sans-serif;
            max-width: 1600px;
            margin: 0 auto;
            padding: 20px;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat({{ columns }}, 1fr);
            gap: 30px;
            padding: 20px;
        }
        .diagram {
            margin-bottom: 20px;
        }
        h2 {
            color: #333;
            border-bottom: 1px solid #ddd;
            padding-bottom: 10px;
            font-size: 1.2em;
            margin-top: 0;
        }
        img {
            max-width: 100%;
            height: auto;
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 10px;
        }
        @media (max-width: 1200px) {
            .grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="grid">
        {% for diagram in diagrams %}
        <div class="diagram">
            <img src="{{ diagram.path }}" alt="{{ diagram.alt }}">
        </div>
        {% endfor %}
    </div>
</body>
</html>
"""

# Render the template
env = Environment(loader=BaseLoader())
template = env.from_string(template)
html = template.render(diagrams=diagrams, columns=columns)

# Write the output
outfile.write_text(html)
print(f"Generated {outfile} with {len(diagrams)} diagrams")
